{
  "name": "html-editor",
  "version": "1.0.0",
  "description": "- WYSIWYG editor (by [TinyMCE](https://github.com/tinymce/tinymce)) - Markdown ↔ HTML converter (by [Turndown](https://github.com/mixmark-io/turndown) & [Showdown](https://github.com/showdownjs/showdown)) - Code editor (by [CodeMirror](https://github.com/codemirror/dev)) - Other libraries [Prettier](https://github.com/prettier/prettier), [DOMPurify](https://github.com/cure53/DOMPurify), HTML entity encoder/decoder [he](https://github.com/mathiasbynens/he)",
  "main": "index.js",
  "scripts": {
    "build": "rollup -c",
    "dev": "browser-sync start --server --files 'index.html, dist/**/*' --serveStatic './' --port 3000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/copthuy/html-editor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/copthuy/html-editor/issues"
  },
  "homepage": "https://github.com/copthuy/html-editor#readme",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.42.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.2",
    "he": "^1.2.0",
    "prettier": "^3.8.3",
    "showdown": "^2.1.0",
    "tinymce": "^8.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "browser-sync": "^3.0.4",
    "lightningcss": "^1.32.0",
    "postcss-lightningcss": "^1.1.0",
    "rollup": "^4.60.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-postcss": "^4.0.2"
  }
}
